# Maintainer: huntsman11177 <sahasubrata11177@gmail.com>
pkgname=cg
pkgver=1.3.0
pkgrel=1
pkgdesc='Fast multi-threaded POSIX/GNU-style grep'
arch=('x86_64' 'aarch64' 'riscv64')
url='https://github.com/huntsman11177/cg'
license=('MIT')
depends=('glibc')
source=("https://github.com/huntsman11177/cg/releases/download/v${pkgver}/${pkgname}-${pkgver}.tar.gz")
sha256sums=('d5b94b2e485c5ec4d6d2974d998761f42efa2a49c3c0629d023a6280dc69a1d5')

build() {
  cd "${pkgname}-${pkgver}"
  make
}

check() {
  cd "${pkgname}-${pkgver}"
  make check
}

package() {
  cd "${pkgname}-${pkgver}"
  make DESTDIR="${pkgdir}" PREFIX=/usr install
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
