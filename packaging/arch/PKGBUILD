# Maintainer: huntsman11177 <sahasubrata11177@gmail.com>
pkgname=cg
pkgver=1.3.1
pkgrel=1
pkgdesc='Fast multi-threaded POSIX/GNU-style grep'
arch=('x86_64' 'aarch64' 'riscv64')
url='https://github.com/huntsman11177/cg'
license=('MIT')
depends=('glibc')
source=("https://github.com/huntsman11177/cg/releases/download/v${pkgver}/${pkgname}-${pkgver}.tar.gz")
sha256sums=('d94dfd8d3abcdb39eb890e8ddbf323850a5ecd2779ee65c24f970138785419da')

build() {
  cd "${pkgname}-${pkgver}"
  make
}

check() {
  cd "${pkgname}-${pkgver}"
  make check
}

package() {
  cd "${pkgname}-${pkgver}"
  make DESTDIR="${pkgdir}" PREFIX=/usr install
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
